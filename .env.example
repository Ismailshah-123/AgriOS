# AgriOS environment variables — names and safe placeholders only. Never put real secrets here.
# Two git-ignored copies are used locally:
#   ./.env          -> read by docker compose (POSTGRES_* values)
#   ./backend/.env  -> read by the API (DATABASE_URL, JWT_SECRET, ...)

# ---------------------------------------------------------------- docker compose (./.env)
POSTGRES_DB=agrios
POSTGRES_USER=agrios
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_PORT=5433
POSTGRES_TEST_PASSWORD=<choose-a-different-local-password>
POSTGRES_TEST_PORT=5434

# ------------------------------------------------------------------- API (./backend/.env)
# development | test | production  (production disables /api/v1/docs and requires JWT_SECRET)
APP_ENV=development
LOG_LEVEL=INFO

# SQLAlchemy URL (psycopg 3 driver). Leave unset to run the API without a database;
# /api/v1/ready then reports "not_configured" and data endpoints return 503.
# DATABASE_URL=postgresql+psycopg://agrios:<password>@127.0.0.1:5433/agrios
DATABASE_CONNECT_TIMEOUT=5

# Isolated database for the test suite ONLY. Its name must contain "test".
# Without Docker: `cd backend && uv run python scripts/test_db.py start` prints a value.
# TEST_DATABASE_URL=postgresql+psycopg://agrios_test:<password>@127.0.0.1:5434/agrios_test

# Signing key for access tokens: >= 32 random characters. Required in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=<random-48-characters>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# true on HTTPS deployments (refresh cookie gets the Secure flag)
COOKIE_SECURE=false

# Comma-separated explicit origins. '*' is rejected.
ALLOWED_ORIGINS=http://localhost:5173

# Private upload storage (never served directly) and installed model versions.
STORAGE_PATH=./var/uploads
MODEL_PATH=./var/models
# Optional deploy-time model fetch (hosts with an ephemeral disk, e.g. Render). https zip with
# package.json + model.onnx (+ cam_weights.npy) and its SHA-256. Unset = model_unavailable.
# MODEL_PACKAGE_URL=
# MODEL_PACKAGE_SHA256=

# API docs (/api/v1/docs) are on outside production; set true to expose them in production.
# API_DOCS_ENABLED=

# Frontend (frontend/.env.local). Defaults to /api/v1 via the Vite dev proxy.
# VITE_API_BASE_URL=/api/v1

# Knowledge / RAG (backend/.env). Both default to "none": answers are then quoted passages.
# LLM_PROVIDER=none            # none | groq | xai | ollama | openai_compatible
# LLM_API_KEY=                 # groq/xai key (never commit); not needed for ollama
# LLM_MODEL=                   # preset per provider (groq: openai/gpt-oss-120b)
# LLM_FALLBACK_MODEL=          # tried on HTTP 429 (groq preset: openai/gpt-oss-20b)
# LLM_BASE_URL=                # required for openai_compatible
# EMBEDDING_PROVIDER=none      # none | fastembed (local multilingual ONNX, ~220 MB download)
